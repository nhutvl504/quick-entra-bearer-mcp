# Copy to .env and `source .env` (or set in CI) before `cdk deploy`.
# Nothing here is a secret except what you choose to put in Secrets Manager.

# ── Entra ID (Azure AD) inbound ─────────────────────────────────────────
export ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"
# Application ID URI of your Entra app registration (the token 'aud').
export ENTRA_AUDIENCE="api://your-entra-app-id"
# Optional: pin the Entra app client id as an allowed client.
export ENTRA_ALLOWED_CLIENT=""
# Where Entra puts the email. Often "preferred_username" or "upn" — CHECK a token.
export EMAIL_CLAIM="email"

# ── 3rd-party API + special endpoint (outbound) ─────────────────────────
# For the DEMO, after first deploy you can point this at the demo API's
# function URL (printed as DemoThirdPartyApiUrl). For prod, the real vendor URL.
export THIRD_PARTY_BASE_URL="https://api.customer.example.com"
# The endpoint that exchanges { email } -> { access_token, expires_in }.
export SPECIAL_TOKEN_ENDPOINT="https://auth.customer.example.com/token-for-email"
# Optional Secrets Manager secret name if the special endpoint needs a credential.
export SPECIAL_ENDPOINT_SECRET_NAME=""
# Seconds to cache a minted bearer per email.
export TOKEN_CACHE_TTL="300"

# ── AWS target ──────────────────────────────────────────────────────────
export CDK_DEFAULT_REGION="us-east-1"
export AWS_REGION="us-east-1"
